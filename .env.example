# The key you get from OpenRouter https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=${OPENROUTER_API_KEY}

# OpenAI Configuration(Optional, if using OpenAI models)
OPENAI_API_KEY=${OPENAI_API_KEY}

# Anthropic Configuration (Optional, if using Anthropic models)
ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}

# Database Configuration (for devcontainer)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/pydantic_ai_db

# Redis Configuration (for devcontainer)
REDIS_URL=redis://redis:6379

# Application Configuration
LOG_LEVEL=INFO
ENVIRONMENT=development

# MCP Configuration (Optional)
CONTEXT7_API_KEY=${CONTEXT7_API_KEY}

# Copilot CLI authentication token (Optional, if using Copilot CLI)
COPILOT_GITHUB_TOKEN=${COPILOT_GITHUB_TOKEN}

# Git configuration for devcontainer (optional)
# - Used by /.devcontainer/post-create.sh to set git user identity during setup
GIT_USER_NAME=${GIT_USER_NAME}
GIT_USER_EMAIL=${GIT_USER_EMAIL}

# Tavily API key for web search tool (Optional, if using Tavily for web search)
TAVILY_API_KEY=${TAVILY_API_KEY}
